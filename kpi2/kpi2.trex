<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.rcxsports.vizext.kpicard2" extension-version="1.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>RCX KPI2 — duplicate of the KPI card (big number, YoY delta, trend). Independent copy so the original stays intact.</description>
    <author name="RCX Sports" email="admin@rcxsports.com" organization="RCX Sports" website="https://rcxsports.com"/>
    <min-api-version>1.12</min-api-version>

    <source-location>
      <url>https://knalige.github.io/RCX-kpi-card/kpi2/index.html</url>
    </source-location>

    <icon/>

    <!-- Encoding tiles that appear on the Marks card. These are how the card is reused:
         drop ANY measure on "Value" and it renders. Comparison and Trend are optional. -->
    <encoding id="value">
      <display-name>Value</display-name>
    </encoding>
    <encoding id="comparison">
      <display-name>Comparison (prior period)</display-name>
    </encoding>
    <encoding id="trend">
      <display-name>Trend date (line x-axis)</display-name>
    </encoding>
    <encoding id="trendvalue">
      <display-name>Trend value (line height)</display-name>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">RCX KPI2</text>
    </resource>
  </resources>
</manifest>
